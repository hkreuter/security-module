{% extends 'form/login.html.twig' %}

{% block checkout_login_form_captcha %}
    {% include '@oe_security_module/form/captcha.html.twig' %}
{% endblock %}

{% block checkout_login_form %}
    {{ parent() }}
    {% set oxcmp_user = oView.getComponent("oxcmp_user") %}
    {% if oxcmp_user and oxcmp_user.isTwoFactorAuthRequired() %}
        {% include '@oe_security_module/form/twofactorauth_modal.html.twig' %}
    {% endif %}
{% endblock %}
